<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HealthGoalsTracker.ViewModels"
             xmlns:controls="clr-namespace:HealthGoalsTracker.Controls"
             x:Class="HealthGoalsTracker.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Health Goals">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: date + scores -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="20,18,20,10"
                             Spacing="2">
            <Label Text="{Binding TodayDateText}"
                   FontSize="13"
                   TextColor="Gray" />
            <Label Text="{Binding DailyScoreText}"
                   FontSize="24"
                   FontAttributes="Bold" />
            <Label Text="{Binding WeeklyScoreText}"
                   FontSize="16"
                   TextColor="Gray" />
        </VerticalStackLayout>

        <!-- Goal grid + loading indicator in the same slot -->
        <Grid Grid.Row="1">
            <CollectionView ItemsSource="{Binding Goals}"
                            SelectionMode="None"
                            Margin="12,8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GoalCardViewModel">
                        <controls:GoalCard HeightRequest="160" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No goals yet. Tap '+ Add Goal' below."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray"
                           Margin="32,40" />
                </CollectionView.EmptyView>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="#512BD4" />
        </Grid>

        <!-- Add Goal button -->
        <Button Grid.Row="2"
                Text="+ Add Goal"
                Command="{Binding AddGoalCommand}"
                Margin="16,8,16,20"
                HorizontalOptions="Fill"
                BackgroundColor="#512BD4"
                TextColor="White"
                CornerRadius="12"
                FontSize="16"
                FontAttributes="Bold"
                HeightRequest="52" />

        <!-- ── Overlays (span all three rows, above all content) ── -->

        <!-- Confetti particle canvas -->
        <controls:ConfettiView x:Name="ConfettiCanvas"
                               Grid.RowSpan="3"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />

        <!-- "All goals complete" celebration banner -->
        <Border x:Name="CelebrationBanner"
                Grid.RowSpan="3"
                IsVisible="False"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                BackgroundColor="#DD000000"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="32,24"
                InputTransparent="True">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="🎉"
                       FontSize="52"
                       HorizontalOptions="Center" />
                <Label Text="All Goals Complete!"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                <Label Text="Incredible day! Keep it up 💪"
                       FontSize="14"
                       TextColor="#CCFFFFFF"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>

