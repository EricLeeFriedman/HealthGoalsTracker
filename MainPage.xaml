<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HealthGoalsTracker.ViewModels"
             xmlns:controls="clr-namespace:HealthGoalsTracker.Controls"
             x:Class="HealthGoalsTracker.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Health Goals">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: date + score -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="20,18,20,10"
                             Spacing="2">
            <Label Text="{Binding TodayDateText}"
                   FontSize="13"
                   TextColor="Gray" />
            <Label Text="{Binding ScoreText}"
                   FontSize="24"
                   FontAttributes="Bold" />
        </VerticalStackLayout>

        <!-- Goal list + loading indicator in the same slot -->
        <Grid Grid.Row="1">
            <CollectionView ItemsSource="{Binding Goals}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GoalCardViewModel">
                        <controls:GoalCard Margin="16,6" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No goals yet. Tap '+ Add Goal' below."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray"
                           Margin="32,40" />
                </CollectionView.EmptyView>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="#512BD4" />
        </Grid>

        <!-- Add Goal button -->
        <Button Grid.Row="2"
                Text="+ Add Goal"
                Command="{Binding AddGoalCommand}"
                Margin="16,8,16,20"
                HorizontalOptions="Fill"
                BackgroundColor="#512BD4"
                TextColor="White"
                CornerRadius="12"
                FontSize="16"
                FontAttributes="Bold"
                HeightRequest="52" />

    </Grid>

</ContentPage>

