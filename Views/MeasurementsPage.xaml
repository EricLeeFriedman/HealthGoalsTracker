<ContentPage
    x:Class="HealthGoalsTracker.Views.MeasurementsPage"
    Title="Body Measurements"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:HealthGoalsTracker.Controls"
    x:Name="ThisPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Entry Form Section -->
            <Border Stroke="#D3D3D3" StrokeShape="RoundRectangle 8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Log Measurement" FontSize="1.2" FontAttributes="Bold" />
                    
                    <Label Text="Date:" />
                    <DatePicker AutomationId="MeasurementDate"
                                Date="{Binding SelectedDate}"
                                Format="yyyy-MM-dd" />

                    <Label Text="Weight (lbs):" />
                    <Entry AutomationId="MeasurementWeight"
                           Placeholder="e.g. 180"
                           Keyboard="Numeric"
                           Text="{Binding WeightLbs}"/>

                    <Label Text="Body Fat %:" />
                    <Entry AutomationId="MeasurementBodyFat"
                           Placeholder="e.g. 22"
                           Keyboard="Numeric"
                           Text="{Binding BodyFatPercent}"/>

                    <Label Text="Notes:" />
                    <Editor AutomationId="MeasurementNotes"
                            Text="{Binding Notes}"
                            HeightRequest="100" />

                    <Button AutomationId="SaveMeasurement"
                            Text="Save Measurement"
                            Command="{Binding SaveMeasurementCommand}" 
                            BackgroundColor="#5D3FD3" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#D3D3D3" StrokeShape="RoundRectangle 8" Padding="10">
                <controls:MeasurementChartView AutomationId="MeasurementChart"
                                               Measurements="{Binding Measurements}" />
            </Border>

            <!-- List of Recent Entries -->
            <Label Text="Recent History" FontSize="1.2" FontAttributes="Bold" />
            <CollectionView AutomationId="MeasurementHistory"
                            ItemsSource="{Binding Measurements}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Padding="10">
                            <Label Text="{Binding Date}" WidthRequest="100"/>
                            <Label Text="{Binding WeightLbs, StringFormat='{0} lbs'}" />
                            <Label Text="{Binding BodyFatPercent, StringFormat='{0}%'}" Margin="20,0" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>