<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HealthGoalsTracker.ViewModels"
             x:Class="HealthGoalsTracker.Controls.GoalCard"
             x:DataType="vm:GoalCardViewModel">

    <Border BackgroundColor="{Binding CardColor}"
            StrokeThickness="0"
            Stroke="Transparent">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="Auto,*,Auto" Padding="10,8,10,12">

            <!-- Options button — top right -->
            <Button Grid.Row="0"
                    Text="•••"
                    FontSize="13"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    HorizontalOptions="End"
                    WidthRequest="36"
                    HeightRequest="30"
                    Padding="0"
                    Command="{Binding OpenOptionsCommand}" />

            <!-- Centre: emoji + goal name -->
            <VerticalStackLayout Grid.Row="1"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="2">
                <Label Text="{Binding IconEmoji}"
                       FontSize="32"
                       HorizontalOptions="Center" />
                <Label Text="{Binding Name}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       MaxLines="2" />
            </VerticalStackLayout>

            <!-- Bottom: points badge -->
            <Label Grid.Row="2"
                   Text="{Binding PointsBadgeText}"
                   FontSize="12"
                   TextColor="White"
                   Opacity="0.8"
                   HorizontalOptions="Center" />

        </Grid>
    </Border>

</ContentView>
